# ============================================================
# IGo Academy Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── Supabase (PostgreSQL Database) ──────────────────────────
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── PostgreSQL direct (Supabase) ─────────────────────────────
# NOTE: use the Session Pooler host from Supabase (Settings -> Database -> Connection Pooling)
# if the direct db.<ref>.supabase.co host is not reachable from your network (common on IPv4-only networks).
DB_HOST=your-pooler-or-direct-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_db_password
DB_SSL=true

# ── Redis (local dev / AWS ElastiCache prod) ─────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRES_IN=7d
SESSION_INACTIVITY_MINUTES=30

# ── Supabase Storage (replaces AWS S3) ───────────────────────
SUPABASE_STORAGE_BUCKET_VIDEOS=igo-videos
SUPABASE_STORAGE_BUCKET_CERTS=igo-certificates
SUPABASE_STORAGE_BUCKET_UPLOADS=igo-uploads
SIGNED_URL_EXPIRY_SECONDS=7200

# ── AWS SES (Email) ──────────────────────────────────────────
SES_FROM_EMAIL=noreply@igoacademy.in
SES_FROM_NAME=IGo Academy
# Alternatively use SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_app_password

# ── APITxT (SMS/OTP delivery — apitxt.com) ────────────────────
# We generate our own OTP and just ask APITxT to text it — no separate
# "verify" API call, verification is a local comparison (same mechanism
# as the email OTP flow below, just a different delivery channel).
APITXT_API_KEY=your_apitxt_authkey_here

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── Firebase Cloud Messaging ─────────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key

# ── Certificate ──────────────────────────────────────────────
CERT_VERIFICATION_BASE_URL=https://igoacademy.in/verify

# ── Razorpay (Payment Gateway) ────────────────────────────────
RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Separate from the API secret above — set in Razorpay Dashboard →
# Account & Settings → Webhooks → add https://api.igoacademy.in/api/payments/webhook
# (event: payment.captured, payment.failed), then paste the secret shown there.
# Leave blank for local dev — /verify covers enrollment without it.
RAZORPAY_WEBHOOK_SECRET=

# ── Cron ─────────────────────────────────────────────────────
EXPIRY_CRON_SCHEDULE=30 18 * * *
